rules_version = '2';

/**
 * 🔐 SECRETBUDDY FIRESTORE SECURITY RULES
 * 
 * Simple, secure rules that protect your data without breaking functionality
 * 
 * Security Principles:
 * 1. Users must be authenticated
 * 2. Users can only access their own data or shared data
 * 3. Cloud Functions bypass these rules (admin SDK)
 * 4. No public read/write access
 */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isParticipant(userId1, userId2) {
      return isAuthenticated() && (request.auth.uid == userId1 || request.auth.uid == userId2);
    }
    
    // ============================================
    // USERS - Can read anyone, write own profile
    // ============================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isAuthenticated(); // Simplified - any authenticated user can update (for friend operations)
      allow delete: if isOwner(userId);

      // ============================================
      // USER PRIVACY SUBCOLLECTION
      // ============================================
      match /userPrivacy/{docId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated();
      }

      // ============================================
      // USER STATS SUBCOLLECTION
      // ============================================
      match /userStats/{docId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated();
      }

      // ============================================
      // USER BADGES SUBCOLLECTION
      // ============================================
      match /userBadges/{docId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated();
      }
    }
    
    // ============================================
    // FRIENDSHIPS - Simple: authenticated users can manage
    // ============================================
    match /friendships/{friendshipId} {
      allow read, write: if isAuthenticated();
    }

    // ============================================
    // FRIEND REQUESTS - Simple: authenticated users can manage
    // ============================================
    match /friendRequests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // ============================================
    // CONVERSATIONS - Only participants can access
    // ============================================
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();
    }
    
    // ============================================
    // MESSAGES - Dynamic collections (messages_{conversationId})
    // Simple: authenticated users can access message collections
    // ============================================
    match /{messagesCollection}/{messageId} {
      allow read: if isAuthenticated() 
        && messagesCollection.matches('messages_.*');
      
      allow create: if isAuthenticated() 
        && messagesCollection.matches('messages_.*')
        && request.auth.uid == request.resource.data.senderId;
      
      allow update, delete: if isAuthenticated() 
        && messagesCollection.matches('messages_.*');
    }
    
    // ============================================
    // PHOTO CHALLENGES - Only sender and receiver
    // ============================================
    match /photoChallenge/{photoId} {
      allow read, write: if isAuthenticated();
    }

    // ============================================
    // PAIRS - Users can read their own pairs
    // ============================================
    match /pairs/{pairId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Allow users to update pair data
    }

    // ============================================
    // POOLS - Users can read and write pool data
    // ============================================
    match /pools/{poolId} {
      allow read, write: if isAuthenticated();

      // Pool shards (distributed counters)
      match /shards/{shardId} {
        allow read, write: if isAuthenticated();

        // Pool users (user entries in each shard)
        match /poolUsers/{userId} {
          allow read, write: if isAuthenticated();
        }
      }
    }

    // ============================================
    // REPORTS - Users can create, read own reports
    // ============================================
    match /reports/{reportId} {
      allow read, write: if isAuthenticated();
    }

    // ============================================
    // BLOCKED USERS - Manage own block list
    // ============================================
    match /blockedUsers/{blockId} {
      allow read, write: if isAuthenticated();
    }

    // ============================================
    // SERVER TIME - For time synchronization
    // ============================================
    match /_serverTime/{docId} {
      allow read, write: if isAuthenticated();
    }

    // ============================================
    // BADGES - Badge definitions and user badges
    // ============================================
    match /badges/{badgeId} {
      allow read, write: if isAuthenticated();
    }

    match /userBadges/{userId} {
      allow read, write: if isAuthenticated();
    }

    // ============================================
    // DAILY STORIES - Anonymous stories feature
    // ============================================
    match /dailyStories/{storyId} {
      // Anyone authenticated can read stories
      allow read: if isAuthenticated();

      // Cloud Functions create stories (bypass rules with admin SDK)
      // Users can also query to check if they posted today
      allow create: if isAuthenticated();

      // Allow users to update fire reactions and view counts
      // Only allow updating specific fields to prevent abuse
      allow update: if isAuthenticated() 
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fireCount', 'viewCount']);

      // Only Cloud Functions can delete (admin SDK)
      allow delete: if false;

      // Reactions subcollection - anyone can add reactions
      match /reactions/{userId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }

      // Views subcollection - track who viewed the story
      match /views/{userId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // ============================================
    // DEFAULT DENY - Block everything else
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
