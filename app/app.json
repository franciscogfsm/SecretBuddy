{
  "expo": {
    "name": "SecretBuddy",
    "slug": "secretbuddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "secretbuddy",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#12002f"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.secretbuddy.app",
      "usesAppleSignIn": false,
      "infoPlist": {
        "NSCameraUsageDescription": "SecretBuddy needs camera access to take and share photos with your anonymous buddy while keeping your identity hidden."
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "owner": "franciscogfsm"
  }
}
